# Named verbs for the workspace. `just` with no argument lists them.

# Build every crate.
build:
    cargo build --workspace

# Test every crate.
test:
    cargo test --workspace

# Lint + format check — what CI would run.
check:
    cargo clippy --workspace
    cargo fmt --check

# Run a command against tower's OWN broker (compose.test.yaml, 31416), brought
# up before it and taken down after it. The url is fixed here rather than read
# from the environment, so no inherited NATS_URL can aim the run at the fleet's
# broker on 4222. The Broker fake covers ordinary tests; reach for this only
# when a run genuinely needs a real broker.
#
#     just broker-run 'cargo test -p bridge -- --ignored'
broker-run +command:
    #!/bin/sh
    set -eu
    # One teardown point: every catchable signal routes through exit, so the
    # EXIT trap is the only place the container comes down, and it comes down
    # whether the run passed, failed or was interrupted. `down` is scoped by
    # the project name compose.test.yaml declares, so it reaches that broker
    # and can reach nothing else. SIGKILL cannot be caught by anything.
    trap 'status=$?; docker compose -f compose.test.yaml down; exit $status' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    docker compose -f compose.test.yaml up -d nats
    # Blocks until the streams are converged; stream-init waits for the broker
    # itself, so nothing here has to poll for readiness.
    docker compose -f compose.test.yaml run --rm stream-init
    # Exported, not prefixed onto the command. A prefix covers the single
    # command it prefixes, so the right-hand side of a `&&`, a `;` or a pipe
    # would inherit the caller's environment and default back to 4222 — the
    # one thing this recipe exists to prevent.
    export NATS_URL='nats://127.0.0.1:31416'
    # The broker is not the only real thing a run can reach: bridge's memory
    # and history stores default to ~/.claude, which it shares with
    # claude-sdk-cli, and it writes to them. Scratch paths here, so what the
    # recipe isolates is everything a run through it opens.
    export BRIDGE_REFS_DB='/tmp/tower-test-refs.db'
    export BRIDGE_MEMORY_DB='/tmp/tower-test-memory.db'
    export BRIDGE_HISTORY_DB='/tmp/tower-test-history.db'
    {{command}}

# Run towerd (env NATS_URL, TOWER_BIND, TOWER_BIND_LEPTOS, TOWER_DB all
# default to the local deployment). Serves frontend-svelte/dist on TOWER_BIND
# and frontend-leptos/dist on TOWER_BIND_LEPTOS — see `just frontend`.
run:
    cargo run -p towerd

# Bring the whole mvp up: towerd + BOTH frontends with hot reload, side by
# side for comparison. Multi-process orchestration is the one job cargo
# doesn't do; dev.sh owns it. The broker is expected up (docker compose up
# -d). Web: leptos http://localhost:8082, svelte http://localhost:5174.
dev:
    ./dev.sh

# Build the webapps towerd serves. dist/ is gitignored, so a fresh clone
# runs this once (or uses `just dev` and never needs it).
frontend:
    cd frontend-svelte && pnpm install && pnpm build
    cd frontend-leptos && trunk build

# Title conversations from their own content, through bridge's model client.
# Dry run unless --apply. Compare a sample without writing:
#
#     just titles --compare --sample 5
#     just titles --apply --limit 5
#     just titles --help
titles *args:
    cargo run -p bridge --example title-conversations -- {{args}}

# Validate every changes.jsonl against the schema derived from changes.config.json.
changes-validate:
    node ../scripts/validate-changes.mts

# Regenerate every package's CHANGELOG.md from its changes.jsonl.
changes-changelog:
    node ../scripts/generate-all-changelogs.mts

# Regenerate schema/shellicar-changes.schema.json from changes.config.json.
changes-schema:
    node ../scripts/generate-changes-schema.mts

# CI check: fail if the changelogs are out of date with their changes.jsonl.
changes-check: changes-validate
    node ../scripts/generate-all-changelogs.mts
    cd .. && git diff --exit-code -- '*/CHANGELOG.md'
